# Supabase credentials — copy this to .env and fill in your values
# Never commit .env to git. See .gitignore.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-public-key...

# Server-only key. NEVER commit a real value, NEVER send it to the browser.
# Used only for the `users` lookup in includes/auth.php (bypasses RLS on the
# users table). Get it from Supabase Dashboard > Project Settings > API > service_role.
# If unset, logins fail closed.
SUPABASE_SERVICE_KEY=
# Optional: tests can target a separate project via .env.test when APP_ENV=test.
