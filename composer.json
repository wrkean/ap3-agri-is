{
    "name": "ap3/agri-system",
    "description": "Agriculture Information System — AP3 Midterm Project, Cebu Technological University",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpdocumentor/phpdocumentor": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "AgriInfo\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000",
        "docs": "phpdoc -d . -t docs/api --ignore vendor/,node_modules/,database/",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "optimize-autoloader": true,
        "audit": {
            "abandoned": "ignore",
            "advisories": "ignore"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
